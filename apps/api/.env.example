DATABASE_URL="postgresql://schoolsyncer:schoolsyncer@localhost:5432/schoolsyncer?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN="http://localhost:3000"

# Behind a reverse proxy, set to the number of proxy hops (e.g. "1") or their
# addresses so sign-in rate limits use the real client IP. Empty = direct.
TRUST_PROXY=""

# Notifications: "log" (default, prints messages) or "whatsapp" (WhatsApp Cloud API)
NOTIFY_DRIVER="log"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_LANGUAGE="en"

# Shared secrets for payment gateway callbacks (HMAC-SHA256 of the raw body in X-Signature)
PAYMENT_WEBHOOK_SECRET_JAZZCASH=""
PAYMENT_WEBHOOK_SECRET_EASYPAISA=""
PAYMENT_WEBHOOK_SECRET_ONEBILL=""

# Online fee payments (parents paying vouchers): "mock" (default outside
# production; a sandbox checkout page in the portal, no money moves),
# "sandbox" (the gateways' test environments), "live", or "off" (default when
# NODE_ENV=production).
PAYMENTS_MODE="mock"
# Public URLs the gateways send parents and notifications back to.
API_PUBLIC_URL="http://localhost:4000"
WEB_PUBLIC_URL="http://localhost:3000"
# Minutes a wallet checkout stays open, and days a 1Bill number can be paid.
PAYMENTS_CHECKOUT_MINUTES=60
ONEBILL_VALID_DAYS=3

# JazzCash merchant (HTTP POST page redirection, v1.1). Return URL:
# {API_PUBLIC_URL}/api/payments/return/jazzcash
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""

# Easypaisa store (Easypay hosted checkout + Inquire Transaction API).
# IPN URL to register: {API_PUBLIC_URL}/api/payments/ipn/easypaisa
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_USERNAME=""
EASYPAISA_PASSWORD=""
EASYPAISA_ACCOUNT_NUM=""

# 1Bill biller (1LINK). 1LINK calls {API_PUBLIC_URL}/api/payments/1bill/bill-inquiry
# and /bill-payment with these credentials in username/password headers.
ONEBILL_BILLER_PREFIX=""
ONEBILL_USERNAME=""
ONEBILL_PASSWORD=""
