DATABASE_URL="postgresql://schoolsyncer:schoolsyncer@localhost:5432/schoolsyncer?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN="http://localhost:3000"

# Behind a reverse proxy, set to the number of proxy hops (e.g. "1") or their
# addresses so sign-in rate limits use the real client IP. Empty = direct.
TRUST_PROXY=""

# Notifications: "log" (default, prints messages) or "whatsapp" (WhatsApp Cloud API)
NOTIFY_DRIVER="log"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_LANGUAGE="en"

# Shared secrets for payment gateway callbacks (HMAC-SHA256 of the raw body in X-Signature)
PAYMENT_WEBHOOK_SECRET_JAZZCASH=""
PAYMENT_WEBHOOK_SECRET_EASYPAISA=""
PAYMENT_WEBHOOK_SECRET_ONEBILL=""

# E-school file uploads: "local" (default, files under STORAGE_LOCAL_DIR) or "s3" (any S3-compatible bucket)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="uploads"
# Address browsers use to reach this API; signed local download links start with it.
API_PUBLIC_URL="http://localhost:4000"
S3_BUCKET=""
S3_REGION=""
# Only for non-AWS services, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

