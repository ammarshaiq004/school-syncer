# Set NODE_ENV=production on servers. The API then refuses to start on unsafe
# settings: placeholder, short, patterned or shared secrets, http or localhost
# public URLs, or PAYMENTS_MODE=mock. docs/secrets.md lists every secret, how
# to generate it and how to rotate it.
DATABASE_URL="postgresql://schoolsyncer:schoolsyncer@localhost:5432/schoolsyncer?schema=public"
# 32+ random characters in production, e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-to-a-long-random-string"
# Rotation only: the old JWT_SECRET, still accepted for verifying sessions (and
# reset codes) until JWT_EXPIRES_IN has passed. Comma-separated for several.
JWT_SECRET_PREVIOUS=""
JWT_EXPIRES_IN="12h"
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN="http://localhost:3000"

# Behind a reverse proxy, set to the number of proxy hops (e.g. "1") or their
# addresses so sign-in rate limits use the real client IP. Empty = direct.
TRUST_PROXY=""

# AI assistant (Growth and Enterprise plans). Without a key, questions are off
# and drafts come from templates; the at-risk list works either way.
ANTHROPIC_API_KEY=""
# Claude model; default claude-opus-5-5.
ASSISTANT_MODEL=""
# Model requests per user per day (default 100).
ASSISTANT_DAILY_LIMIT=""

# Messaging. A school's own WhatsApp number (System settings > Messaging) always
# wins; otherwise NOTIFY_DRIVER picks the platform sender:
# "log" (default): nothing is delivered, messages are marked "Not delivered";
# "whatsapp": WhatsApp Cloud API with the token and phone number id below;
# "sms": the HTTP SMS gateway below.
NOTIFY_DRIVER="log"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_LANGUAGE="en"
# Generic HTTP SMS gateway (any aggregator). The URL may hold {to}, {from},
# {message} and {apiKey} placeholders for query-string gateways, e.g.
# https://sms.example.pk/send?key={apiKey}&to={to}&mask={from}&text={message}
# Without placeholders: JSON POST { to, from, message } with a Bearer API key.
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID=""
# GET or POST (default) for placeholder URLs.
SMS_GATEWAY_METHOD=""
# Optional pattern the response body must match to count as accepted.
SMS_GATEWAY_SUCCESS_MATCH=""

# Background jobs run in every API process (Postgres queue, no Redis).
# "off" runs this instance without workers; at least one instance must run them.
JOBS_WORKER="on"
# How often a worker looks for due jobs (ms) and how many it runs at once.
JOBS_POLL_MS=2000
JOBS_CONCURRENCY=5

# Shared secrets for payment gateway callbacks (HMAC-SHA256 of the raw body in X-Signature)
PAYMENT_WEBHOOK_SECRET_JAZZCASH=""
PAYMENT_WEBHOOK_SECRET_EASYPAISA=""
PAYMENT_WEBHOOK_SECRET_ONEBILL=""

# E-school file uploads: "local" (default, files under STORAGE_LOCAL_DIR) or "s3" (any S3-compatible bucket)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="uploads"
# Address browsers use to reach this API; signed local download links start with it.
# https in production.
API_PUBLIC_URL="http://localhost:4000"
# Signs those links. Required in production with the local driver: 32+ random
# characters, different from JWT_SECRET. Empty in development = JWT_SECRET.
FILE_SIGNING_SECRET=""
# Rotation only: the old signing secret, still accepted for links already handed out.
FILE_SIGNING_SECRET_PREVIOUS=""
S3_BUCKET=""
S3_REGION=""
# Only for non-AWS services, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Online fee payments (parents paying vouchers): "off" (default when
# NODE_ENV=production), "sandbox" (the gateways' test environments), "live",
# or "mock" (default outside production).
# Mock is for development only: a sandbox checkout page in the portal where
# parents approve their own payments, signed with keys published in the source.
# The API refuses to start with PAYMENTS_MODE=mock in production. Leave this
# empty to get the default for NODE_ENV.
PAYMENTS_MODE=""
# Gateways send parents back through API_PUBLIC_URL (above) to this portal address.
# https in production.
WEB_PUBLIC_URL="http://localhost:3000"
# Minutes a wallet checkout stays open, and days a 1Bill number can be paid.
PAYMENTS_CHECKOUT_MINUTES=60
ONEBILL_VALID_DAYS=3

# Encrypts schools' own merchant secrets (System settings > Online payments) and
# WhatsApp tokens (System settings > Messaging).
# 64 hex characters or any 32+ character passphrase, e.g. `openssl rand -hex 32`.
# Required for sandbox and live. Losing it loses every saved school secret.
PAYMENTS_SECRET_KEY=""
# Rotation only: the old key(s), comma-separated, used to decrypt (never to
# encrypt) until `pnpm --filter api secrets:reencrypt --apply` has resealed
# everything with PAYMENTS_SECRET_KEY. See docs/secrets.md.
PAYMENTS_SECRET_KEY_PREVIOUS=""

# The server's own merchant accounts, used by schools without one of their own.
# Leave empty if every school brings its own account.
# JazzCash merchant (HTTP POST page redirection, v1.1). Return URL:
# {API_PUBLIC_URL}/api/payments/return/jazzcash
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
# IPN URL to register with JazzCash: {API_PUBLIC_URL}/api/payments/ipn/jazzcash

# Easypaisa store (Easypay hosted checkout + Inquire Transaction API).
# IPN URL to register: {API_PUBLIC_URL}/api/payments/ipn/easypaisa
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_USERNAME=""
EASYPAISA_PASSWORD=""
EASYPAISA_ACCOUNT_NUM=""

# 1Bill biller (1LINK). 1LINK calls {API_PUBLIC_URL}/api/payments/1bill/bill-inquiry
# and /bill-payment with these credentials in username/password headers.
ONEBILL_BILLER_PREFIX=""
ONEBILL_USERNAME=""
ONEBILL_PASSWORD=""

# Nightly reconciliation of online payments, school-local time ("off" disables it).
RECONCILE_AT="02:00"

# Monitoring. Everything here is optional; with nothing set, errors go to the
# log only and alerts show in the console's System health page and the log.
# Error tracking with Sentry or a self-hosted GlitchTip: the project's DSN.
# Events are scrubbed of passwords, tokens, CNICs, phones and payment secrets.
SENTRY_DSN=""
# Defaults to NODE_ENV; the release is shown with each error (e.g. a git sha).
SENTRY_ENVIRONMENT=""
SENTRY_RELEASE=""
# "json" or "pretty". Default: JSON lines in production, Nest's coloured lines elsewhere.
LOG_FORMAT=""
# Slack-compatible incoming webhook ({"text": ...}) for alerts; https in production.
# Platform staff with a phone (Console > Platform staff) also get alerts through
# the platform WhatsApp or SMS sender above.
ALERT_WEBHOOK_URL=""
# How often the alert check runs (minutes, or "off"), and how often the same
# open problem is repeated (minutes).
ALERT_EVERY_MINUTES=5
ALERT_REPEAT_MINUTES=360
# Thresholds: background jobs failed for good in the last hour, and the share
# (percent) of the last hour's messages that failed, out of at least N.
ALERT_FAILED_JOBS=5
ALERT_MESSAGE_FAILURE_PERCENT=20
ALERT_MESSAGE_MIN_COUNT=20
# GET /api/health/ready answers 503 when the oldest due job waited longer than
# this, more jobs than this are due, or the last successful nightly
# reconciliation is older than this.
READY_MAX_JOB_LAG_SECONDS=900
READY_MAX_JOB_BACKLOG=10000
READY_MAX_RECONCILE_AGE_HOURS=36
