// SchoolSyncer data model, Phase 0: tenancy, people, access and academic structure.
// Every tenant-owned table carries schoolId; services always filter by it.

generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (Migrate) and
// src/prisma/client.ts (the driver adapter the app connects with).
datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  PRINCIPAL
  ADMIN
  ACCOUNTANT
  TEACHER
  CLASS_TEACHER
  PARENT
  STUDENT
  STAFF
}

/// What kind of school this is. Only drives which screens are shown; every
/// module keeps working in every mode.
enum SchoolMode {
  PHYSICAL
  ONLINE
  HYBRID
}

model School {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  mode      SchoolMode @default(PHYSICAL)
  city      String?
  phone     String?
  email     String?
  logoUrl   String?
  locale    String     @default("en")
  currency  String     @default("PKR")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  campuses             Campus[]
  academicYears        AcademicYear[]
  classes              Class[]
  subjects             Subject[]
  users                User[]
  auditLogs            AuditLog[]
  lateFeePerDay        Int            @default(0)
  feeDueDay            Int            @default(10)
  /// Late fine caps: at most this many days are charged, and at most this many
  /// rupees on one voucher. Null means no cap.
  lateFeeMaxDays       Int?
  lateFeeCap           Int?
  /// Sibling discount (SCHOOL-140): percent off the listed fee heads for the
  /// second child of a family, and for the third and later children.
  siblingSecondPercent Int            @default(0)
  siblingThirdPercent  Int            @default(0)
  siblingFeeHeadIds    String[]       @default([])
  /// A one-time fee head billed on its own voucher when a student is admitted,
  /// at the amount the fee setup gives the student's class. Null = none.
  admissionFeeHeadId   String?
  /// Monthly runs move an earlier voucher's unpaid balance onto the new voucher.
  carryForwardArrears  Boolean        @default(false)

  students          Student[]
  guardians         Guardian[]
  applications      Application[]
  feeHeads          FeeHead[]
  invoices          Invoice[]
  voucherRuns       VoucherRun[]
  onlinePayments    OnlinePayment[]
  gatewayTestRuns   GatewayTestRun[]
  notifications     NotificationLog[]
  announcements     Announcement[]
  gradeBands        GradeBand[]
  exams             Exam[]
  payrollRuns       PayrollRun[]
  accountCategories AccountCategory[]
  accountEntries    AccountEntry[]

  subscription      Subscription?
  platformInvoices  PlatformInvoice[]
  platformPayments  PlatformPayment[]
  platformNotices   PlatformNotice[]
  vehicles          Vehicle[]
  transportRoutes   TransportRoute[]
  books             Book[]
  certificates      Certificate[]
  libraryLoanDays   Int               @default(14)
  libraryFinePerDay Int               @default(5)
  libraryMaxLoans   Int               @default(2)

  customRoles     CustomRole[]
  rolePermissions BuiltinRolePermission[]

  courses     Course[]
  liveClasses LiveClass[]
  assignments Assignment[]
  quizzes     Quiz[]

  lessonPlans LessonPlan[]
  chatThreads ChatThread[]

  files StoredFile[]

  assistantUsage AssistantUsage[]

  reconciliations      PaymentReconciliation[]
  reconciliationIssues ReconciliationIssue[]
  gatewayStatements    GatewayStatement[]
  paymentGateways      SchoolPaymentGateway[]

  messagingSender SchoolMessagingSender?
  passwordResets  PasswordResetCode[]

  /// The owner hid the setup checklist on the dashboard before finishing it.
  setupChecklistDismissedAt DateTime?
  problemReports            ProblemReport[]
  activityDays              UserActivityDay[]
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes     Class[]
  assignments RoleAssignment[]

  students     Student[]
  applications Application[]

  periods         Period[]
  transportRoutes TransportRoute[]
  bookCopies      BookCopy[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // e.g. "2026-27"
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]

  enrollments   Enrollment[]
  feeStructures FeeStructure[]
  promotions    Promotion[]

  exams   Exam[]
  courses Course[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  campusId  String
  name      String // e.g. "Grade 5"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus   Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections Section[]

  applications  Application[]
  feeStructures FeeStructure[]

  examPapers ExamPaper[]

  @@unique([campusId, name])
  @@index([schoolId])
}

model Section {
  id             String   @id @default(cuid())
  schoolId       String
  classId        String
  academicYearId String
  name           String // e.g. "A"
  capacity       Int?
  classTeacherId String?
  createdAt      DateTime @default(now())

  class        Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classTeacher User?            @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  subjects     SectionSubject[]

  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]

  examResults ExamResult[]

  timetable TimetableSlot[]
  homework  Homework[]

  courses     Course[]
  liveClasses LiveClass[]
  assignments Assignment[]
  quizzes     Quiz[]

  lessonPlans LessonPlan[]

  @@unique([classId, academicYearId, name])
  @@index([schoolId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String?
  createdAt DateTime @default(now())

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections SectionSubject[]

  examPapers ExamPaper[]

  timetableSlots TimetableSlot[]
  homework       Homework[]

  courses     Course[]
  liveClasses LiveClass[]
  assignments Assignment[]
  quizzes     Quiz[]

  lessonPlans LessonPlan[]

  @@unique([schoolId, name])
}

model SectionSubject {
  id        String  @id @default(cuid())
  schoolId  String
  sectionId String
  subjectId String
  teacherId String?

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([sectionId, subjectId])
  @@index([schoolId])
}

model User {
  id                 String    @id @default(cuid())
  schoolId           String
  name               String
  email              String?
  phone              String?
  /// Sign-in name for accounts without email/phone (students: admission number, lowercased).
  username           String?
  passwordHash       String?
  /// Set when someone else issued the password (admin create/reset, generated
  /// student or parent logins); the API refuses everything but me and
  /// change-password until the user picks their own.
  mustChangePassword Boolean   @default(false)
  /// Signed into each token as `tv`; bumped on a password change or reset so
  /// older tokens stop working.
  tokenVersion       Int       @default(0)
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles           RoleAssignment[]
  classTeacherOf  Section[]        @relation("ClassTeacher")
  teachesSubjects SectionSubject[]

  guardianProfile   Guardian?
  attendanceTaken   AttendanceSession[]
  paymentsReceived  Payment[]
  announcementsSent Announcement[]

  timetableSlots   TimetableSlot[]
  homeworkAssigned Homework[]

  staffProfile       StaffProfile?
  staffAttendance    StaffAttendance[]
  leaveRequests      LeaveRequest[]
  payslips           Payslip[]
  bookLoans          BookLoan[]        @relation("BookLoans")
  certificatesIssued Certificate[]

  studentProfile     Student?
  coursesTaught      Course[]
  liveClassesTaught  LiveClass[]
  assignmentsCreated Assignment[] @relation("AssignmentCreatedBy")
  submissionsGraded  Submission[] @relation("SubmissionGradedBy")
  filesUploaded      StoredFile[]
  quizzesCreated     Quiz[]

  lessonPlans         LessonPlan[]  @relation("LessonPlanTeacher")
  lessonPlansReviewed LessonPlan[]  @relation("LessonPlanReviewer")
  chatThreadsAsParent ChatThread[]  @relation("ChatThreadGuardian")
  chatThreadsAsStaff  ChatThread[]  @relation("ChatThreadStaff")
  chatMessagesSent    ChatMessage[]

  problemReports ProblemReport[]
  activityDays   UserActivityDay[]

  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@unique([schoolId, username])
}

// A role held by a user, either school-wide (campusId null) or at one campus.
// With customRoleId set, `role` is the custom role's baseRole: @Roles guards
// see the base role, the permission layer uses the custom role's matrix.
model RoleAssignment {
  id           String  @id @default(cuid())
  userId       String
  role         Role
  campusId     String?
  customRoleId String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus     Campus?     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  // Restrict: a custom role cannot be deleted while anyone holds it (DELETE /roles/:id answers 409).
  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: Restrict)

  // The same base role may be held plainly and through a custom role. The
  // index is NULLS NOT DISTINCT (set in migration SQL, Postgres 15+), so a
  // school-wide or plain grant cannot be stored twice either.
  @@unique([userId, role, campusId, customRoleId])
  @@index([customRoleId])
}

// ----- Roles and permissions (module layer under the @Roles ceiling) -----
//
// Design: both custom roles and edits to built-in roles store a sparse Json map
// `{ [module]: "none" | "view" | "manage" }` (see src/common/permissions.ts)
// rather than one row per (role, module). The matrix is always read whole and
// cached per school, so one row per role is one cheap read; and modules added
// by later releases simply fall back to the defaults when absent from the map,
// with no data migration. Levels are validated by zod on write.

// A school-defined role, e.g. "Exam coordinator". baseRole is a built-in role
// other than OWNER, PARENT or STUDENT and is what @Roles guards check.
model CustomRole {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  baseRole    Role
  // Sparse module -> level map; missing modules use the base role's level.
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@unique([schoolId, name])
}

// A school's edits to a built-in role's default matrix (never OWNER, which
// always has manage everywhere). One row per edited role; absent = defaults.
model BuiltinRolePermission {
  id          String   @id @default(cuid())
  schoolId    String
  role        Role
  // Sparse module -> level map overriding DEFAULT_PERMISSIONS[role].
  permissions Json     @default("{}")
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, role])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  action    String // e.g. "campus.create"
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  // Set when the change was made in a support session: { adminId, adminName }
  // of the SchoolSyncer staff member acting as userId.
  support   Json?
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, entity, createdAt])
  @@index([schoolId, userId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 1: students, admissions, attendance, fees, communication
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  LEFT
  GRADUATED
  SUSPENDED
}

model Student {
  id           String        @id @default(cuid())
  schoolId     String
  campusId     String
  admissionNo  String
  firstName    String
  lastName     String?
  gender       Gender
  dateOfBirth  DateTime?     @db.Date
  bFormNo      String? // NADRA B-Form number, 13 digits
  /// A stable signed link to the photo (see students/student-photo.ts), for avatars and ID cards.
  photoUrl     String?
  /// The uploaded photo behind photoUrl; replacing or removing it deletes the old file.
  photoFileId  String?       @unique
  address      String?
  medicalNotes String?
  status       StudentStatus @default(ACTIVE)
  admittedOn   DateTime      @default(now()) @db.Date
  /// The student's own sign-in (a User with the STUDENT role), if one was created.
  userId       String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus      Campus             @relation(fields: [campusId], references: [id], onDelete: Restrict)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoFile   StoredFile?        @relation("StudentPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  guardians   StudentGuardian[]
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  invoices    Invoice[]
  concessions Concession[]
  application Application?

  marks        Mark[]
  examResults  ExamResult[]
  transport    TransportAssignment[]
  bookLoans    BookLoan[]
  certificates Certificate[]
  promotions   Promotion[]

  lessonProgress LessonProgress[]
  liveAttendance LiveAttendance[]
  submissions    Submission[]
  quizAttempts   QuizAttempt[]

  chatThreads ChatThread[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
}

model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  userId     String?  @unique // parent login, once invited
  name       String
  phone      String
  email      String?
  cnic       String?
  occupation String?
  createdAt  DateTime @default(now())

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@unique([schoolId, phone])
}

model StudentGuardian {
  studentId  String
  guardianId String
  relation   String // e.g. "Father", "Mother", "Uncle"
  isPrimary  Boolean @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED
  LEFT
  REPEATED // kept back in the same class for another year
  GRADUATED // finished the school's last class
}

// A student's place in a section for one academic year; history is kept across years.
model Enrollment {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  sectionId      String
  academicYearId String
  rollNo         Int?
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([schoolId, sectionId])
}

enum ApplicationStage {
  ENQUIRY
  TEST_SCHEDULED
  TEST_DONE
  INTERVIEW
  OFFERED
  ADMITTED
  REJECTED
  WITHDRAWN
}

model Application {
  id             String           @id @default(cuid())
  schoolId       String
  campusId       String
  classId        String
  childName      String
  gender         Gender
  dateOfBirth    DateTime?        @db.Date
  previousSchool String?
  guardianName   String
  guardianPhone  String
  guardianEmail  String?
  relation       String           @default("Father")
  source         String? // e.g. "Walk-in", "Facebook", "Referral"
  stage          ApplicationStage @default(ENQUIRY)
  testDate       DateTime?
  testScore      Float?
  notes          String?
  studentId      String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus  Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, stage])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

// One attendance sheet per section per day.
model AttendanceSession {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  date      DateTime @db.Date
  takenById String?
  takenAt   DateTime @default(now())

  section Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  takenBy User?              @relation(fields: [takenById], references: [id], onDelete: SetNull)
  records AttendanceRecord[]

  @@unique([sectionId, date])
  @@index([schoolId, date])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  note      String?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

enum FeeFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

model FeeHead {
  id        String       @id @default(cuid())
  schoolId  String
  name      String // e.g. "Tuition", "Admission", "Transport"
  frequency FeeFrequency @default(MONTHLY)
  createdAt DateTime     @default(now())

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structures  FeeStructure[]
  concessions Concession[]
  lines       InvoiceLine[]

  @@unique([schoolId, name])
}

// The amount a class pays for a fee head in an academic year (PKR, whole rupees).
model FeeStructure {
  id             String @id @default(cuid())
  schoolId       String
  classId        String
  feeHeadId      String
  academicYearId String
  amount         Int

  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([classId, feeHeadId, academicYearId])
}

enum ConcessionType {
  PERCENT
  FIXED
}

model Concession {
  id        String         @id @default(cuid())
  studentId String
  feeHeadId String
  type      ConcessionType
  value     Int // percent (0-100) or rupees
  reason    String?
  /// The first and last billing months (YYYY-MM) it applies to; null = open-ended.
  validFrom String?
  validTo   String?
  createdAt DateTime       @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeHead FeeHead @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeHeadId])
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
  /// The unpaid balance moved onto a later voucher (carriedToId); owed there, not here.
  CARRIED_FORWARD
}

enum InvoiceKind {
  MONTHLY // a month's voucher from a voucher run
  ADHOC // a one-off voucher for one student: admission, registration, a one-time charge
}

model Invoice {
  id               String        @id @default(cuid())
  schoolId         String
  studentId        String
  voucherNo        String        @unique
  period           String // "2026-10" for monthly fees
  issueDate        DateTime      @default(now()) @db.Date
  dueDate          DateTime      @db.Date
  total            Int
  paid             Int           @default(0)
  status           InvoiceStatus @default(UNPAID)
  kind             InvoiceKind   @default(MONTHLY)
  /// The billing month on a MONTHLY voucher, null on ad-hoc ones: one monthly
  /// voucher per student per month, however often a run is repeated.
  monthlyPeriod    String?
  createdAt        DateTime      @default(now())
  /// Set when the voucher is voided (status CANCELLED); the reason is required.
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?
  /// Late fine already added to `total` as LATE_FINE lines (net of waivers).
  fineBooked       Int           @default(0)
  /// Set when the fee office waives the late fine; no more fine builds up.
  fineWaivedAt     DateTime?
  fineWaivedById   String?
  fineWaiverReason String?
  /// Earlier balances carried onto this voucher as ARREARS lines (part of `total`).
  arrears          Int           @default(0)
  carriedToId      String?
  runId            String?

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  carriedTo    Invoice?        @relation("CarriedForward", fields: [carriedToId], references: [id], onDelete: SetNull)
  carriedFrom  Invoice[]       @relation("CarriedForward")
  run          VoucherRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]
  libraryFines BookLoan[]
  checkouts    OnlinePayment[]

  @@unique([studentId, monthlyPeriod])
  @@index([schoolId, period, status])
  @@index([schoolId, status, dueDate])
}

enum VoucherRunStatus {
  RUNNING
  DONE
  FAILED
}

/// One press of "Generate vouchers": what it billed, skipped and carried forward.
model VoucherRun {
  id          String           @id @default(cuid())
  schoolId    String
  period      String
  classId     String?
  /// Held while the run is going so a double click cannot start a second one.
  lockKey     String?          @unique
  status      VoucherRunStatus @default(RUNNING)
  startedById String?
  startedAt   DateTime         @default(now())
  finishedAt  DateTime?
  students    Int              @default(0)
  created     Int              @default(0)
  skipped     Int              @default(0)
  totalBilled Int              @default(0)
  carried     Int              @default(0)
  messages    Int              @default(0)
  error       String?

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([schoolId, startedAt])
}

enum InvoiceLineKind {
  FEE // billed when the voucher was generated
  ADJUSTMENT // a discount (negative) or extra charge added by the fee office afterwards
  SIBLING_DISCOUNT // the school's sibling discount, applied by the voucher run
  LATE_FINE // a late fine booked onto the voucher (negative when waived)
  ARREARS // an earlier voucher's unpaid balance carried forward
}

model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  feeHeadId   String?
  description String
  amount      Int
  kind        InvoiceLineKind @default(FEE)
  /// Why an adjustment was made, and by whom.
  reason      String?
  addedById   String?

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead FeeHead? @relation(fields: [feeHeadId], references: [id], onDelete: SetNull)
}

enum PaymentMethod {
  CASH
  BANK
  JAZZCASH
  EASYPAISA
  ONEBILL
  CARD
}

model Payment {
  id             String        @id @default(cuid())
  schoolId       String
  invoiceId      String
  amount         Int
  method         PaymentMethod
  reference      String? // gateway or bank transaction id, or whatever the counter typed
  /// Set only when the payment must never be counted twice: a gateway
  /// transaction or a client-supplied key. Free-text references are not keys.
  idempotencyKey String?
  receiptNo      String        @unique
  receivedAt     DateTime      @default(now())
  receivedById   String?
  /// A reversed payment stays on record (with its receipt number) but no longer counts.
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?

  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedBy User?          @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  checkout   OnlinePayment?

  // A gateway transaction (or a retried request) is only ever counted once per school.
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, method, reference])
  @@index([schoolId, receivedAt])
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  /// Waiting for a delivery job (or for its next retry).
  QUEUED
  /// Accepted by the provider (WhatsApp Cloud API or the SMS gateway).
  SENT
  /// Only written to the server log: no provider is configured, nothing was delivered.
  LOGGED
  /// Every attempt failed; `error` holds the last provider error.
  FAILED
}

model NotificationLog {
  id                String             @id @default(cuid())
  schoolId          String
  channel           Channel
  to                String
  template          String // e.g. "attendance.absent"
  body              String
  status            NotificationStatus @default(QUEUED)
  error             String?
  /// Delivery attempts so far.
  attempts          Int                @default(0)
  /// Who sent it: "school" (the school's own WhatsApp number), "platform" or "log".
  sender            String?
  /// The provider's message id once accepted.
  providerMessageId String?
  createdAt         DateTime           @default(now())
  sentAt            DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  /// Monitoring: delivery failures across every school.
  @@index([createdAt, status])
}

enum Audience {
  SCHOOL
  CAMPUS
  CLASS
  SECTION
}

model Announcement {
  id           String   @id @default(cuid())
  schoolId     String
  title        String
  body         String
  audience     Audience
  targetId     String? // campus, class or section id
  sendWhatsApp Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 2: exams, marks and report cards
// ---------------------------------------------------------------------------

// Percentage bands that turn a score into a grade, e.g. 80% and above is "A".
model GradeBand {
  id         String  @id @default(cuid())
  schoolId   String
  grade      String
  minPercent Float
  remark     String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, grade])
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

model Exam {
  id             String     @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String // e.g. "Mid-term 2026"
  startsOn       DateTime?  @db.Date
  endsOn         DateTime?  @db.Date
  status         ExamStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  papers       ExamPaper[]
  results      ExamResult[]

  @@unique([academicYearId, name])
  @@index([schoolId])
}

// One subject's paper for one class in an exam.
model ExamPaper {
  id        String    @id @default(cuid())
  examId    String
  classId   String
  subjectId String
  maxMarks  Float
  passMarks Float
  date      DateTime? @db.Date

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks   Mark[]

  @@unique([examId, classId, subjectId])
}

model Mark {
  id          String   @id @default(cuid())
  paperId     String
  studentId   String
  marks       Float?
  isAbsent    Boolean  @default(false)
  enteredById String?
  updatedAt   DateTime @updatedAt

  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([paperId, studentId])
}

// A student's result, frozen when the exam is published.
model ExamResult {
  id              String   @id @default(cuid())
  examId          String
  studentId       String
  sectionId       String
  obtained        Float
  maxTotal        Float
  percent         Float
  grade           String
  position        Int
  passed          Boolean
  // Per-subject marks as published: [{ subject, max, pass, marks, absent, passed }]
  subjects        Json
  teacherRemark   String?
  principalRemark String?
  createdAt       DateTime @default(now())

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// Phase 2: timetable and homework
// ---------------------------------------------------------------------------

// A campus's bell schedule: the periods of a school day, in order.
model Period {
  id        String  @id @default(cuid())
  schoolId  String
  campusId  String
  name      String // e.g. "Period 1", "Break"
  startTime String // "08:00", campus local time
  endTime   String
  sortOrder Int
  isBreak   Boolean @default(false)

  campus Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  slots  TimetableSlot[]

  @@unique([campusId, sortOrder])
  @@index([schoolId])
}

// What a section studies in one period on one weekday.
model TimetableSlot {
  id        String  @id @default(cuid())
  schoolId  String
  sectionId String
  dayOfWeek Int // 1 = Monday ... 7 = Sunday
  periodId  String
  subjectId String
  teacherId String?
  room      String?

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  period  Period  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  liveClasses LiveClass[]

  @@unique([sectionId, dayOfWeek, periodId])
  // A teacher can only be in one class at a time.
  @@unique([teacherId, dayOfWeek, periodId])
  @@index([schoolId])
}

model Homework {
  id           String   @id @default(cuid())
  schoolId     String
  sectionId    String
  subjectId    String
  assignedById String?
  title        String
  details      String?
  dueDate      DateTime @db.Date
  createdAt    DateTime @default(now())

  section    Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation(fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([sectionId, dueDate])
  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Phase 2: HR, staff attendance and payroll
// ---------------------------------------------------------------------------

enum StaffStatus {
  ACTIVE
  LEFT
}

// Employment details for a staff user. Amounts are whole rupees per month.
model StaffProfile {
  id          String      @id @default(cuid())
  schoolId    String
  userId      String      @unique
  employeeNo  String
  designation String
  department  String?
  joinedOn    DateTime?   @db.Date
  cnic        String?
  basicSalary Int         @default(0)
  bankName    String?
  bankAccount String?
  status      StaffStatus @default(ACTIVE)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payItems StaffPayItem[]

  @@unique([schoolId, employeeNo])
}

enum PayItemType {
  ALLOWANCE
  DEDUCTION
}

// A fixed monthly allowance or deduction, e.g. "House rent" or "Provident fund".
model StaffPayItem {
  id        String      @id @default(cuid())
  profileId String
  name      String
  type      PayItemType
  amount    Int

  profile StaffProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model StaffAttendance {
  id         String           @id @default(cuid())
  schoolId   String
  userId     String
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([schoolId, date])
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id          String      @id @default(cuid())
  schoolId    String
  userId      String
  type        LeaveType
  fromDate    DateTime    @db.Date
  toDate      DateTime    @db.Date
  reason      String?
  status      LeaveStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

enum PayrollStatus {
  DRAFT
  FINALIZED
}

model PayrollRun {
  id            String        @id @default(cuid())
  schoolId      String
  period        String // "YYYY-MM"
  status        PayrollStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  createdById   String?
  updatedAt     DateTime      @updatedAt
  finalizedAt   DateTime?
  finalizedById String?

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([schoolId, period])
}

model Payslip {
  id              String    @id @default(cuid())
  runId           String
  userId          String
  basic           Int
  allowances      Int
  deductions      Int
  unpaidDays      Int
  unpaidDeduction Int
  net             Int
  // [{ name, type, amount }] as calculated
  lines           Json
  paidAt          DateTime?
  paidById        String?
  paymentMethod   String?

  run  PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([runId, userId])
}

// ---------------------------------------------------------------------------
// Phase 2: accounts
// ---------------------------------------------------------------------------

enum EntryKind {
  INCOME
  EXPENSE
}

enum EntryMethod {
  CASH
  BANK
  CHEQUE
}

// e.g. "Utilities" (expense) or "Canteen rent" (income). Fees and salaries are
// tracked by their own modules and appear in the cash book automatically.
model AccountCategory {
  id       String    @id @default(cuid())
  schoolId String
  name     String
  kind     EntryKind

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entries AccountEntry[]

  @@unique([schoolId, kind, name])
}

// Money in or out that isn't a fee or a salary. Amounts are whole rupees.
model AccountEntry {
  id          String      @id @default(cuid())
  schoolId    String
  campusId    String?
  categoryId  String
  kind        EntryKind
  amount      Int
  date        DateTime    @db.Date
  party       String? // paid to / received from
  method      EntryMethod @default(CASH)
  reference   String?
  note        String?
  createdById String?
  createdAt   DateTime    @default(now())

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category AccountCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([schoolId, date])
}

// ---------------------------------------------------------------------------
// SaaS platform: plans, subscriptions, platform billing and SchoolSyncer staff
// ---------------------------------------------------------------------------

// A price plan. Schools pay per active student per month, with a minimum.
model Plan {
  id              String   @id @default(cuid())
  code            String   @unique // "starter", "growth", "enterprise"
  name            String
  description     String?
  pricePerStudent Int // PKR per active student per month
  minimumMonthly  Int // PKR
  maxStudents     Int? // null = unlimited
  maxCampuses     Int?
  maxStorageMb    Int? // e-school uploads; null = unlimited
  // Feature keys from src/platform/plans.ts, e.g. ["fees", "exams"]
  features        String[]
  isPublic        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id              String             @id @default(cuid())
  schoolId        String             @unique
  planId          String
  status          SubscriptionStatus @default(TRIAL)
  trialEndsAt     DateTime?
  notes           String? // SchoolSyncer staff notes, never shown to the school
  // Per-school feature overrides (keys from src/platform/plans.ts FEATURES).
  // Effective features = plan.features + featuresAdded - featuresRemoved.
  featuresAdded   String[]           @default([])
  featuresRemoved String[]           @default([])
  // First month ("YYYY-MM") the nightly bill run charges; null = any month.
  // A school that leaves its trial starts paying from the next month.
  billedFrom      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)
}

enum PlatformInvoiceStatus {
  UNPAID
  PAID
  VOID
}

// What SchoolSyncer bills a school for a month. A bill stays UNPAID until
// payments cover it in full; amountPaid shows how much has been applied.
model PlatformInvoice {
  id         String                @id @default(cuid())
  number     String                @unique // "SS-202610-0007"
  schoolId   String
  period     String // "YYYY-MM"
  planName   String
  students   Int
  // Total due, tax included.
  amount     Int
  // Sales tax inside `amount`, at taxPercent; 0 while tax is switched off.
  taxPercent Int                   @default(0)
  taxAmount  Int                   @default(0)
  // Paid so far, from PlatformPaymentAllocation; rebuilt after every payment change.
  amountPaid Int                   @default(0)
  status     PlatformInvoiceStatus @default(UNPAID)
  dueDate    DateTime              @db.Date
  // When the last of it was paid, and how (from the payment that settled it).
  paidAt     DateTime?
  method     String?
  reference  String?
  voidReason String?
  createdAt  DateTime              @default(now())

  school      School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allocations PlatformPaymentAllocation[]

  @@unique([schoolId, period])
  @@index([status])
}

enum PlatformPaymentStatus {
  RECORDED
  VOID
}

// Money a school paid SchoolSyncer. It is applied to the oldest unpaid bills
// first; whatever is left over is the school's credit.
model PlatformPayment {
  id         String                @id @default(cuid())
  number     String                @unique // receipt "SR-202610-0003"
  schoolId   String
  amount     Int
  method     String // "Bank transfer", "JazzCash"...
  reference  String?
  receivedOn DateTime              @db.Date
  note       String?
  status     PlatformPaymentStatus @default(RECORDED)
  voidReason String?
  voidedAt   DateTime?
  recordedBy String? // PlatformAdmin name, or null for a migrated bill
  createdAt  DateTime              @default(now())

  school      School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allocations PlatformPaymentAllocation[]

  @@index([schoolId, receivedOn])
}

model PlatformPaymentAllocation {
  id        String @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Int

  payment PlatformPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

enum PlatformNoticeSeverity {
  INFO
  WARNING
  URGENT
}

// A message from SchoolSyncer to a school's owners: shown in the app and,
// when sent, also by SMS and email. dedupeKey stops the nightly run from
// sending the same reminder twice.
model PlatformNotice {
  id        String                 @id @default(cuid())
  schoolId  String
  kind      String // "bill.issued", "bill.due_soon", "payment.received"...
  severity  PlatformNoticeSeverity @default(INFO)
  title     String
  body      String
  invoiceId String?
  paymentId String?
  dedupeKey String                 @unique
  readAt    DateTime?
  createdAt DateTime               @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

// SchoolSyncer's own details printed on bills and receipts. One row (id "default").
model PlatformSettings {
  id                  String   @id @default("default")
  businessName        String   @default("SchoolSyncer")
  address             String?
  phone               String?
  email               String?
  ntn                 String?
  strn                String?
  // Sales tax added to new bills; null keeps tax off.
  salesTaxPercent     Int?
  // How to pay, shown on bills and the school's Plan and billing page.
  paymentInstructions String?
  updatedAt           DateTime @updatedAt
}

// OWNER can edit plans, platform staff, feature overrides and close schools;
// SUPPORT can do everything else in the console.
enum PlatformRole {
  OWNER
  SUPPORT
}

// SchoolSyncer's own staff, who run the platform. Not tied to any school.
model PlatformAdmin {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               PlatformRole @default(SUPPORT)
  // Set when an owner creates the account or resets its password.
  mustChangePassword Boolean      @default(false)
  // Signed into console tokens as `tv`; bumped on a password change or reset.
  tokenVersion       Int          @default(0)
  // Where system alerts reach them (WhatsApp/SMS via the platform sender), stored as 03XXXXXXXXX. Optional.
  phone              String?
  isActive           Boolean      @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())

  auditLogs             PlatformAuditLog[]
  gatewayTestRuns       GatewayTestRun[]
  problemReportActivity ProblemReportActivity[]
}

model PlatformAuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String // e.g. "subscription.update", "school.support_login"
  schoolId  String?
  details   Json?
  createdAt DateTime @default(now())

  admin PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

enum AppPlatform {
  IOS
  ANDROID
}

/// The mobile app's version policy for one store, set in the console. Without
/// a row the APP_*_IOS / APP_*_ANDROID env defaults apply (see app-version/).
model AppRelease {
  platform      AppPlatform @id
  /// Builds below this are refused (426 APP_UPDATE_REQUIRED) and must update.
  minVersion    String
  /// Builds below this are offered an update they can dismiss.
  latestVersion String
  /// Empty: the env default store link.
  storeUrl      String      @default("")
  /// Shown on the update screen and banner; empty for the standard wording.
  message       String      @default("")
  updatedById   String?
  updatedAt     DateTime    @updatedAt
}

// ----- Transport -----

enum VehicleType {
  VAN
  COASTER
  BUS
  CAR
}

// A school van or bus and who drives it.
model Vehicle {
  id             String      @id @default(cuid())
  schoolId       String
  registrationNo String // "LEA-1234"
  type           VehicleType @default(VAN)
  capacity       Int // seats for students
  driverName     String
  driverPhone    String
  driverCnic     String?
  conductorName  String?
  conductorPhone String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routes TransportRoute[]

  @@unique([schoolId, registrationNo])
}

// A pick-up and drop-off run, with the fee it charges each month.
model TransportRoute {
  id         String   @id @default(cuid())
  schoolId   String
  campusId   String?
  name       String // "Route 3: DHA Phase 5"
  vehicleId  String?
  monthlyFee Int // PKR, unless the rider's stop sets its own
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  school      School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus      Campus?               @relation(fields: [campusId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stops       RouteStop[]
  assignments TransportAssignment[]

  @@unique([schoolId, name])
}

model RouteStop {
  id         String  @id @default(cuid())
  routeId    String
  name       String
  position   Int
  pickupTime String? // "07:05"
  dropTime   String? // "14:20"
  monthlyFee Int? // overrides the route's fee for far stops

  route       TransportRoute        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments TransportAssignment[]
}

// A student riding a route from one day until another. endsOn is null while
// they still ride; older rows are the history.
model TransportAssignment {
  id        String    @id @default(cuid())
  schoolId  String
  studentId String
  routeId   String
  stopId    String?
  startsOn  DateTime  @db.Date
  endsOn    DateTime? @db.Date
  createdAt DateTime  @default(now())

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  stop    RouteStop?     @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@index([schoolId, routeId])
  @@index([studentId])
}

// ----- Library -----

enum CopyStatus {
  AVAILABLE
  ON_LOAN
  LOST
  WITHDRAWN
}

enum FineStatus {
  NONE
  DUE // owed, not yet collected
  PAID // paid at the library desk
  BILLED // added to a fee voucher
  WAIVED
}

// A title in the catalogue; the physical books are its copies.
model Book {
  id        String   @id @default(cuid())
  schoolId  String
  title     String
  author    String?
  isbn      String?
  publisher String?
  category  String? // "Fiction", "Reference", "Islamic studies"
  language  String   @default("English")
  shelf     String? // "B-3"
  createdAt DateTime @default(now())

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  copies BookCopy[]

  @@index([schoolId, title])
}

model BookCopy {
  id          String     @id @default(cuid())
  schoolId    String
  bookId      String
  accessionNo String // the number stamped inside the book
  campusId    String?
  status      CopyStatus @default(AVAILABLE)
  addedOn     DateTime   @default(now()) @db.Date

  book   Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  campus Campus?    @relation(fields: [campusId], references: [id], onDelete: SetNull)
  loans  BookLoan[]

  @@unique([schoolId, accessionNo])
}

// A copy lent to a student or a member of staff.
model BookLoan {
  id         String     @id @default(cuid())
  schoolId   String
  copyId     String
  studentId  String?
  userId     String? // staff borrower
  issuedOn   DateTime   @db.Date
  dueOn      DateTime   @db.Date
  returnedOn DateTime?  @db.Date
  lost       Boolean    @default(false)
  fine       Int        @default(0) // PKR: late days, plus the replacement cost if lost
  fineStatus FineStatus @default(NONE)
  invoiceId  String? // the fee voucher the fine went on
  issuedById String?
  createdAt  DateTime   @default(now())

  copy    BookCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?    @relation("BookLoans", fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([schoolId, returnedOn])
  @@index([studentId])
  @@index([userId])
}

enum CertificateType {
  LEAVING // school leaving certificate, issued when a student leaves
  CHARACTER
  ENROLMENT // "is a bonafide student of class ..."
}

// A certificate as issued: the details printed on it are kept as they were
// that day, so a reprint matches the original even after records change.
model Certificate {
  id           String          @id @default(cuid())
  schoolId     String
  studentId    String
  type         CertificateType
  serialNo     String // e.g. "SLC-2026-0007"
  verifyCode   String          @unique // printed on the certificate; anyone can check it online
  issuedOn     DateTime        @db.Date
  details      Json
  issuedById   String
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime        @default(now())

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy User    @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  @@unique([schoolId, serialNo])
  @@index([schoolId, type])
  @@index([studentId])
}

enum PromotionDecision {
  PROMOTE
  REPEAT
  LEAVE
  GRADUATE
}

// What happens to a student at the end of a year, decided section by section
// and carried out together when the next year starts.
model Promotion {
  id          String            @id @default(cuid())
  schoolId    String
  fromYearId  String
  studentId   String
  decision    PromotionDecision
  toSectionId String? // the next year's section, for PROMOTE and REPEAT
  decidedById String
  updatedAt   DateTime          @updatedAt

  fromYear AcademicYear @relation(fields: [fromYearId], references: [id], onDelete: Cascade)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([fromYearId, studentId])
  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// E-school (SCHOOL-26): courses, live classes, assignments, quizzes.
// Content cascades from School/Section; student-owned rows (progress,
// attendance, submissions, attempts) cascade from Student like every other
// per-student record. Staff references are optional and SET NULL so removing
// a user never deletes teaching material.
// ---------------------------------------------------------------------------

/// One subject's online course for one section (SCHOOL-119).
model Course {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  sectionId      String
  subjectId      String
  teacherId      String?
  title          String
  description    String?
  color          String? // kit accent token or hex, e.g. "#4F46E5"
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      User?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  units       CourseUnit[]
  assignments Assignment[]
  quizzes     Quiz[]

  @@unique([sectionId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
}

model CourseUnit {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sortOrder])
}

enum LessonKind {
  VIDEO
  TEXT
  LINK
  DOCUMENT
}

model Lesson {
  id          String     @id @default(cuid())
  unitId      String
  title       String
  kind        LessonKind @default(TEXT)
  body        String? // plain text / simple markdown, rendered without raw HTML
  url         String? // https: YouTube, Vimeo, Drive or any link
  fileId      String?    @unique // an uploaded video or document instead of a link
  durationMin Int?
  sortOrder   Int        @default(0)
  isPublished Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  unit     CourseUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  file     StoredFile?      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  progress LessonProgress[]

  @@index([unitId, sortOrder])
}

model LessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  studentId   String
  completedAt DateTime @default(now())

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

enum LiveProvider {
  JITSI
  ZOOM
  GOOGLE_MEET
  OTHER
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

/// A scheduled online lesson (SCHOOL-118).
model LiveClass {
  id              String       @id @default(cuid())
  schoolId        String
  sectionId       String
  subjectId       String?
  teacherId       String?
  title           String
  startsAt        DateTime
  durationMin     Int          @default(40)
  provider        LiveProvider @default(JITSI)
  joinUrl         String
  status          LiveStatus   @default(SCHEDULED)
  recordingUrl    String?
  timetableSlotId String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section       Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher       User?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  timetableSlot TimetableSlot? @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)

  attendance LiveAttendance[]

  // "Schedule from timetable" skips a slot that already has a class at that time.
  @@unique([timetableSlotId, startsAt])
  @@index([schoolId, startsAt])
  @@index([sectionId, startsAt])
  @@index([teacherId, startsAt])
}

model LiveAttendance {
  id          String    @id @default(cuid())
  liveClassId String
  studentId   String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentId])
  @@index([studentId])
}

/// Online assignment with submissions and grading (SCHOOL-104). The older
/// Homework model stays as the physical-school diary.
model Assignment {
  id            String   @id @default(cuid())
  schoolId      String
  sectionId     String
  subjectId     String
  courseId      String?
  createdById   String?
  title         String
  instructions  String?
  attachmentUrl String?
  attachmentId  String?  @unique // uploaded worksheet or brief
  dueAt         DateTime
  maxPoints     Int      @default(100)
  allowLate     Boolean  @default(true)
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attachment StoredFile? @relation("AssignmentAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  submissions Submission[]

  @@index([schoolId])
  @@index([sectionId, dueAt])
  @@index([courseId])
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  body         String?
  linkUrl      String?
  fileId       String?          @unique // the student's uploaded work
  submittedAt  DateTime         @default(now())
  isLate       Boolean          @default(false)
  status       SubmissionStatus @default(SUBMITTED)
  points       Int?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?

  assignment Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?       @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  file       StoredFile? @relation("SubmissionFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// Online quiz with auto-marking (SCHOOL-103).
model Quiz {
  id               String    @id @default(cuid())
  schoolId         String
  sectionId        String
  subjectId        String
  courseId         String?
  createdById      String?
  title            String
  instructions     String?
  timeLimitMin     Int?
  opensAt          DateTime?
  closesAt         DateTime?
  attemptsAllowed  Int       @default(1)
  shuffleQuestions Boolean   @default(false)
  showResults      Boolean   @default(true)
  isPublished      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([schoolId])
  @@index([sectionId])
  @@index([courseId])
}

enum QuestionKind {
  SINGLE
  MULTI
  TRUE_FALSE
  SHORT
}

model QuizQuestion {
  id        String       @id @default(cuid())
  quizId    String
  kind      QuestionKind
  prompt    String
  /// string[]: the choices (empty for SHORT; ["True","False"] for TRUE_FALSE).
  options   Json         @default("[]")
  /// number[] of correct option indexes, or string[] of accepted answers for SHORT.
  correct   Json         @default("[]")
  points    Int          @default(1)
  sortOrder Int          @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, sortOrder])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  /// { [questionId]: number[] | string } as the student answered.
  answers     Json      @default("{}")
  /// Teacher overrides for SHORT answers: { [questionId]: points }.
  review      Json?
  score       Float?
  maxScore    Float
  needsReview Boolean   @default(false)

  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId, studentId])
  @@index([studentId])
}

enum LessonPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  NEEDS_CHANGES
}

/// A teacher's weekly plan for one section and subject, reviewed by setup
/// roles. Plans outlive the teacher's account (teacherId SET NULL) so the
/// school keeps its curriculum record.
model LessonPlan {
  id           String           @id @default(cuid())
  schoolId     String
  sectionId    String
  subjectId    String
  teacherId    String?
  /// Monday of the planned week.
  weekStart    DateTime         @db.Date
  topic        String
  objectives   String?
  activities   String?
  resources    String?
  homework     String?
  status       LessonPlanStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewerNote String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section    Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    User?   @relation("LessonPlanTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("LessonPlanReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status, weekStart])
  @@index([teacherId, weekStart])
  @@index([sectionId, subjectId, weekStart])
}

/// Parent-teacher conversation about one student (SCHOOL-25). Participant
/// links are SET NULL so the conversation stays on record for safeguarding
/// when an account is removed; a thread with a missing participant is
/// read-only.
model ChatThread {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  guardianUserId String?
  staffUserId    String?
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianUser User?         @relation("ChatThreadGuardian", fields: [guardianUserId], references: [id], onDelete: SetNull)
  staffUser    User?         @relation("ChatThreadStaff", fields: [staffUserId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]

  @@unique([studentId, guardianUserId, staffUserId])
  @@index([schoolId, lastMessageAt])
  @@index([guardianUserId, lastMessageAt])
  @@index([staffUserId, lastMessageAt])
}

model ChatMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String?
  /// Up to 2000 characters (validated in the API and by a DB CHECK).
  body      String
  createdAt DateTime  @default(now())
  /// When the other participant read it; null = unread.
  readAt    DateTime?

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)

  // Conversation paging (?after) and unread counts per thread.
  @@index([threadId, createdAt])
  @@index([threadId, readAt])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Online fee payments: a parent paying a voucher through JazzCash, Easypaisa
// or 1Bill. The checkout is only trusted once the gateway's signed callback
// (or a status inquiry) confirms it; then a Payment is recorded as usual.
// ---------------------------------------------------------------------------

enum CheckoutStatus {
  PENDING // sent to the gateway, waiting for the parent or the bank
  PAID // confirmed and recorded as a Payment
  FAILED // declined, cancelled or timed out at the gateway
  REVIEW // money confirmed but it could not be applied (e.g. the voucher was settled meanwhile)
}

model OnlinePayment {
  id             String         @id @default(cuid())
  schoolId       String
  invoiceId      String
  provider       PaymentMethod // JAZZCASH, EASYPAISA or ONEBILL
  amount         Int // whole rupees, fixed when the checkout starts
  status         CheckoutStatus @default(PENDING)
  /// Our reference sent to the gateway (JazzCash pp_TxnRefNo, Easypaisa orderRefNum).
  txnRef         String         @unique
  /// The number a parent enters in a banking app for 1Bill.
  consumerNumber String?        @unique
  /// The gateway's own transaction id once it reports one.
  providerRef    String?
  responseCode   String?
  message        String?
  createdById    String?
  paymentId      String?        @unique
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  reconciliationIssues ReconciliationIssue[]
  statementLines       GatewayStatementLine[]
  testRun              GatewayTestRun?

  @@index([schoolId, createdAt])
  @@index([invoiceId])
  @@index([status, provider])
}

enum ReconciliationStatus {
  RUNNING
  CLEAN // every online payment of the day agrees with the gateway
  ISSUES // something needs the fee office (see ReconciliationIssue)
  FAILED // the run itself broke; it is retried
}

enum ReconciliationIssueKind {
  NEEDS_REVIEW // money confirmed but held, e.g. the voucher was settled at the counter meanwhile
  RECEIPT_MISMATCH // a paid checkout whose receipt is missing or differs from it
  STILL_PENDING // past its expiry and the gateway still can't say what happened
  NOT_IN_STATEMENT // we issued a receipt the gateway statement doesn't list
  NOT_IN_BOOKS // the gateway statement lists money we have no receipt for
  AMOUNT_MISMATCH // the statement and the checkout disagree on the amount
}

enum ReconciliationIssueStatus {
  OPEN
  RESOLVED
}

/// One school's check of one day's online payments against the gateways
/// (SCHOOL-78). Run every night for the day before, and again on demand or
/// when a gateway statement is uploaded.
model PaymentReconciliation {
  id         String               @id @default(cuid())
  schoolId   String
  date       DateTime             @db.Date // the school-local day checked
  status     ReconciliationStatus @default(RUNNING)
  /// Checkouts started that day that were checked.
  checked    Int                  @default(0)
  /// Open checkouts this run settled by asking the gateway (paid or failed).
  settled    Int                  @default(0)
  /// Per gateway: { books: {count, amount}, statement: {count, amount} | null }.
  totals     Json                 @default("{}")
  openIssues Int                  @default(0)
  trigger    String               @default("auto") // auto, manual or statement
  error      String?
  ranById    String?
  startedAt  DateTime             @default(now())
  finishedAt DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
}

/// Something reconciliation found that a person has to look at. Re-runs update
/// the same row (by key), clear it when it no longer applies, and never reopen
/// one the fee office resolved.
model ReconciliationIssue {
  id              String                    @id @default(cuid())
  schoolId        String
  date            DateTime                  @db.Date
  kind            ReconciliationIssueKind
  provider        PaymentMethod
  status          ReconciliationIssueStatus @default(OPEN)
  /// Stable identity across runs: kind and the reference it is about.
  key             String
  reference       String
  amount          Int?
  detail          String
  onlinePaymentId String?
  statementLineId String?
  note            String?
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  onlinePayment OnlinePayment?        @relation(fields: [onlinePaymentId], references: [id], onDelete: SetNull)
  statementLine GatewayStatementLine? @relation(fields: [statementLineId], references: [id], onDelete: SetNull)

  @@unique([schoolId, key])
  @@index([schoolId, status, date])
}

/// A school's own merchant account with a gateway, so parents' payments
/// settle straight to the school. Schools without one use the server's
/// account from the environment, if it has one. Secrets are AES-256-GCM
/// encrypted with PAYMENTS_SECRET_KEY and never sent back to the browser.
model SchoolPaymentGateway {
  id          String        @id @default(cuid())
  schoolId    String
  provider    PaymentMethod // JAZZCASH, EASYPAISA or ONEBILL
  enabled     Boolean       @default(true)
  /// Identifiers that are not secret: merchant id, store id, biller prefix, usernames.
  settings    Json          @default("{}")
  /// Encrypted JSON of the secrets (passwords, integrity salt, hash key).
  secrets     String        @default("")
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, provider])
}

/// A settlement or transaction report downloaded from a gateway's merchant
/// portal and uploaded by the fee office, covering fromDate..toDate.
model GatewayStatement {
  id           String        @id @default(cuid())
  schoolId     String
  provider     PaymentMethod
  fileName     String
  fromDate     DateTime      @db.Date
  toDate       DateTime      @db.Date
  rows         Int
  matched      Int
  uploadedById String?
  createdAt    DateTime      @default(now())

  school School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lines  GatewayStatementLine[]
}

/// One successful transaction on a gateway statement.
model GatewayStatementLine {
  id              String        @id @default(cuid())
  statementId     String
  schoolId        String
  provider        PaymentMethod
  date            DateTime      @db.Date
  /// Our reference as the gateway shows it (order ref, pp_TxnRefNo or 1Bill consumer number).
  reference       String
  /// The gateway's own transaction id, when the report has one.
  providerRef     String?
  amount          Int
  onlinePaymentId String?

  statement     GatewayStatement      @relation(fields: [statementId], references: [id], onDelete: Cascade)
  onlinePayment OnlinePayment?        @relation(fields: [onlinePaymentId], references: [id], onDelete: SetNull)
  issues        ReconciliationIssue[]

  @@index([schoolId, provider, date])
}

enum FilePurpose {
  LESSON
  ASSIGNMENT
  SUBMISSION
  STUDENT_PHOTO
  PROBLEM_REPORT
}

/// A file uploaded to the school's storage (S3-compatible bucket or local
/// disk, see src/elearning/files). Counted against the plan's maxStorageMb.
/// Attached to at most one lesson, assignment, submission or student photo; files nothing
/// points at are removed when replaced, and unattached uploads after a day.
model StoredFile {
  id           String      @id @default(cuid())
  schoolId     String
  purpose      FilePurpose
  key          String      @unique // object key in the storage driver
  filename     String // original name, cleaned, for downloads
  mimeType     String // from the checked extension, never the client's claim
  size         Int // bytes
  uploadedById String?
  createdAt    DateTime    @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedBy    User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  lesson        Lesson?
  assignment    Assignment?    @relation("AssignmentAttachment")
  submission    Submission?    @relation("SubmissionFile")
  /// A student's photo (purpose STUDENT_PHOTO).
  studentPhoto  Student?       @relation("StudentPhoto")
  /// A screenshot sent with a problem report (purpose PROBLEM_REPORT).
  problemReport ProblemReport? @relation("ProblemReportScreenshot")

  @@index([schoolId])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// AI assistant (SCHOOL-27)
// ---------------------------------------------------------------------------

enum AssistantKind {
  ASK
  DRAFT
}

/// One call to the model, for the daily limit and usage reports. The question
/// and the answer are not stored.
model AssistantUsage {
  id           String        @id @default(cuid())
  schoolId     String
  userId       String
  kind         AssistantKind
  model        String
  inputTokens  Int           @default(0)
  outputTokens Int           @default(0)
  createdAt    DateTime      @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Background jobs, shared rate limits, messaging senders, password reset
// ---------------------------------------------------------------------------

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// A unit of background work, claimed by one worker with FOR UPDATE SKIP LOCKED.
model Job {
  id          String    @id @default(cuid())
  queue       String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  /// Higher runs first among due jobs (a password reset code ahead of a school's fee vouchers).
  priority    Int       @default(0)
  /// Not before this time; pushed back exponentially after each failure.
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  /// Set for scheduled runs ("schedule:reconcile:2026-10-13") so each slot is enqueued once across all servers.
  uniqueKey   String?   @unique
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, priority, runAt])
  @@index([status, lockedAt])
  /// Monitoring: a queue's latest runs and failures.
  @@index([queue, status, finishedAt])
}

/// A problem the monitoring job found (failed jobs, message failures, no
/// reconciliation, readiness failing), kept per key so the same open problem
/// alerts once per ALERT_REPEAT_MINUTES instead of every run.
model PlatformAlert {
  /// Stable identity of the problem, e.g. "jobs.failed" or "readiness.database".
  key            String    @id
  severity       String    @default("warning") // warning or critical
  summary        String
  detail         String    @default("")
  openedAt       DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  lastNotifiedAt DateTime?
  /// How many times admins were told about this problem while open.
  notifications  Int       @default(0)
  /// Set when a run no longer finds the problem; a new occurrence reopens it.
  resolvedAt     DateTime?

  @@index([resolvedAt])
}

/// Fixed-window counters for rate limits, shared by every API instance.
model RateLimitCounter {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

/// A school's own WhatsApp Cloud API sender; without one the platform sender (env) is used.
model SchoolMessagingSender {
  schoolId      String   @id
  enabled       Boolean  @default(true)
  /// WhatsApp Cloud API phone number id (not secret).
  phoneNumberId String   @default("")
  /// Encrypted JSON { token } (PAYMENTS_SECRET_KEY, like merchant secrets).
  secrets       String   @default("")
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// A one-time code for "forgot password", sent to a phone number. Only its hash is stored.
model PasswordResetCode {
  id        String    @id @default(cuid())
  schoolId  String
  /// International format, e.g. 923001234567.
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, phone, createdAt])
}

/// A small real payment made from the console to prove a gateway works end to
/// end (SCHOOL-149): a test voucher for the school's test student, paid through
/// the gateway, then reversed so the school's totals are untouched.
model GatewayTestRun {
  id          String        @id @default(cuid())
  schoolId    String
  provider    PaymentMethod // JAZZCASH, EASYPAISA or ONEBILL
  /// PAYMENTS_MODE when the run started: mock, sandbox or live.
  mode        String
  /// Whose merchant account took the money: "school" or "platform".
  account     String
  amount      Int
  invoiceId   String
  checkoutId  String?       @unique
  startedById String?
  /// The first gateway call about this checkout (return, IPN, 1LINK call or inquiry).
  callbackAt  DateTime?
  /// Every gateway call seen, oldest first: [{ at, kind, verified, status }].
  events      Json          @default("[]")
  reversedAt  DateTime?
  /// Set when the run is closed: reversed, or cancelled before money moved.
  finishedAt  DateTime?
  /// "reversed", "cancelled" or a short reason it could not finish.
  outcome     String?
  createdAt   DateTime      @default(now())

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  checkout  OnlinePayment? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  startedBy PlatformAdmin? @relation(fields: [startedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Pilot kit (SCHOOL-150): problem reports and daily activity
// ---------------------------------------------------------------------------

enum ProblemReportStatus {
  NEW
  IN_PROGRESS
  FIXED
  WONT_FIX
}

enum ProblemReportSource {
  WEB
  MOBILE
}

/// "Report a problem" from the web or mobile app, triaged in the platform console.
model ProblemReport {
  id              String              @id @default(cuid())
  schoolId        String
  reporterId      String?
  /// Kept as sent, so the report still reads right if the account is removed.
  reporterName    String
  roles           Role[]
  source          ProblemReportSource
  message         String
  /// The web path (with its query) or the mobile screen the user was on.
  page            String
  appVersion      String?
  /// The browser's user agent, or the phone's platform and OS version.
  browser         String?
  screenshotId    String?             @unique
  status          ProblemReportStatus @default(NEW)
  statusChangedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  school     School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reporter   User?                   @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  screenshot StoredFile?             @relation("ProblemReportScreenshot", fields: [screenshotId], references: [id], onDelete: SetNull)
  activity   ProblemReportActivity[]

  @@index([schoolId, createdAt])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

/// A status change (shown to the school) or an internal note (console only) on a problem report.
model ProblemReportActivity {
  id         String               @id @default(cuid())
  reportId   String
  adminId    String?
  adminName  String
  /// Set on a status change: the new status.
  status     ProblemReportStatus?
  fromStatus ProblemReportStatus?
  /// Set on an internal note. Never sent to the school.
  note       String?
  createdAt  DateTime             @default(now())

  report ProblemReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  admin  PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
}

/// One row per school user per day they used the API, with the roles they
/// held, for the console's daily active users. Support sessions do not count.
model UserActivityDay {
  userId   String
  date     DateTime @db.Date
  schoolId String
  roles    Role[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([schoolId, date])
}
